{%- comment -%}
  Category tiles for a parent collection (built for /collections/clothing).
  Driven by a Shopify menu so the client edits categories in Online Store > Navigation,
  not here: each top-level menu item is a group (Sarees, Readymade Garments, ...) and its
  child links are the tiles. Tile image = collection image, else its first product's image.
  Empty collections are skipped, and a child that points at its own group's URL
  ("All Sarees") is skipped because the group's "View all" link already covers it. A group
  whose menu item links to "#" (Kurtis & Tops, Pants, ...) is a plain heading with no "View all".
{%- endcomment -%}
{%- assign menu = linklists[section.settings.menu] -%}
{%- if menu.links.size > 0 -%}
<section class="cat-tiles container" aria-label="{{ section.settings.heading | default: 'Shop by category' | escape }}">
  {%- if section.settings.heading != blank -%}
  <h2 class="cat-tiles__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- for group in menu.links -%}
    {%- capture group_tiles -%}
      {%- for link in group.links -%}
        {%- if link.url == group.url -%}{%- continue -%}{%- endif -%}
        {%- if link.type == 'collection_link' -%}
          {%- assign c = link.object -%}
          {%- if c.products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign tile_img = c.image | default: c.products.first.featured_image -%}
          <a class="cat-tiles__tile" href="{{ link.url }}">
            <span class="cat-tiles__media">
              {%- if tile_img -%}
              {{ tile_img | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,300,400', sizes: '(min-width: 990px) 170px, 140px', alt: link.title }}
              {%- endif -%}
            </span>
            <span class="cat-tiles__name">{{ link.title | escape }}</span>
            <span class="cat-tiles__count">{{ c.products_count }} {% if c.products_count == 1 %}item{% else %}items{% endif %}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if group_tiles != blank -%}
    <div class="cat-tiles__group">
      <div class="cat-tiles__group-head">
        <h3 class="cat-tiles__group-title">{{ group.title | escape }}</h3>
        {%- if group.url != '#' and group.url != blank -%}
        <a class="cat-tiles__all" href="{{ group.url }}">View all<span class="visually-hidden"> {{ group.title | escape }}</span></a>
        {%- endif -%}
      </div>
      <div class="cat-tiles__row">{{ group_tiles }}</div>
    </div>
    {%- endif -%}
  {%- endfor -%}
</section>

<style>
  .cat-tiles { margin-top: 2rem; margin-bottom: 1rem; }
  .cat-tiles__heading { font-family: var(--font-heading, serif); font-size: clamp(1.5rem, 3vw, 2rem); color: var(--color-maroon); margin: 0 0 1.5rem; }
  .cat-tiles__group { margin-bottom: 1.75rem; }
  .cat-tiles__group-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; }
  .cat-tiles__group-title { font-family: var(--font-heading, serif); font-size: 1.25rem; color: var(--color-charcoal); margin: 0; }
  .cat-tiles__all { font-size: 14px; font-weight: 600; color: var(--color-maroon); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .cat-tiles__row { display: grid; grid-auto-flow: column; grid-auto-columns: 140px; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
  @media (min-width: 990px) { .cat-tiles__row { grid-auto-columns: 170px; gap: 16px; } }
  .cat-tiles__tile { scroll-snap-align: start; display: flex; flex-direction: column; gap: 4px; color: inherit; text-decoration: none; }
  .cat-tiles__media { display: block; aspect-ratio: 1 / 1; background: var(--color-cream, #f5efe6); overflow: hidden; border-radius: 4px; }
  .cat-tiles__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .cat-tiles__tile:hover .cat-tiles__media img { transform: scale(1.04); }
  .cat-tiles__name { font-size: 15px; font-weight: 600; line-height: 1.3; margin-top: 4px; }
  .cat-tiles .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cat-tiles__count { font-size: 13px; color: rgba(45,45,45,0.7); }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Top-level items become groups, their child links become tiles." },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "presets": [{ "name": "Category tiles" }]
}
{% endschema %}
