{%- comment -%}
  Viha Boutique — saree-type grid. Each block is a collection picker with an
  optional image override, title override and one-line description. Image
  fallback chain (never a hardcoded URL): block image -> collection's own
  image -> the collection's first product image -> a placeholder icon.
  Product counts render live from each collection (its own smart-collection
  rule already requires VARIANT_INVENTORY > 0), never a hardcoded number.
{%- endcomment -%}
<section style="padding:4rem 3rem;background:var(--color-paper);border-top:1px solid var(--color-cream-dark);">
  <div style="max-width:var(--max-w);margin:0 auto;">
    <div style="text-align:center;margin-bottom:2.5rem;">
      <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.2em;color:var(--color-gold);margin-bottom:0.75rem;">{{ section.settings.eyebrow | default: 'Shop By Type' | escape }}</span>
      <h2 style="font-family:var(--font-heading);font-size:clamp(1.25rem,3vw,2rem);font-weight:900;color:var(--color-maroon);">{{ section.settings.heading | default: 'Saree Collections' | escape }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p style="max-width:640px;margin:0.75rem auto 0;font-size:13px;color:rgba(45,45,45,0.65);line-height:1.7;">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.5rem;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'saree_type' -%}
          {%- assign coll = collections[block.settings.collection] -%}
          {%- if coll != blank and coll.products_count > 0 -%}
            <a href="{{ coll.url }}"
              style="display:block;border:1px solid var(--color-cream-dark);border-top:2px solid transparent;border-radius:2px;overflow:hidden;background:var(--color-section-alt);transition:box-shadow 0.2s,border-top-color 0.2s;text-decoration:none;"
              onmouseover="this.style.boxShadow='0 6px 20px rgba(0,0,0,0.10)';this.style.borderTopColor='var(--color-gold)'"
              onmouseout="this.style.boxShadow='';this.style.borderTopColor='transparent'" {{ block.shopify_attributes }}>
              <div style="aspect-ratio:4/3;overflow:hidden;position:relative;background:var(--color-cream);">
                {%- assign card_title = block.settings.title | default: coll.title -%}
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ card_title | escape }}" loading="lazy" width="800" height="600" style="width:100%;height:100%;object-fit:cover;transition:transform 0.5s;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform=''">
                {%- elsif coll.image != blank -%}
                  <img src="{{ coll.image | image_url: width: 800 }}" alt="{{ card_title | escape }}" loading="lazy" width="800" height="600" style="width:100%;height:100%;object-fit:cover;transition:transform 0.5s;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform=''">
                {%- elsif coll.products.first.featured_image != blank -%}
                  <img src="{{ coll.products.first.featured_image | image_url: width: 800 }}" alt="{{ card_title | escape }}" loading="lazy" width="800" height="600" style="width:100%;height:100%;object-fit:cover;transition:transform 0.5s;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform=''">
                {%- else -%}
                  <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:rgba(15,90,67,0.20);">
                    <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z"/></svg>
                  </div>
                {%- endif -%}
                <span style="position:absolute;top:12px;left:12px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--color-gold);background:rgba(253,249,241,0.92);padding:3px 9px;border-radius:2px;">{{ coll.products_count }} saree{{ coll.products_count | pluralize: '', 's' }}</span>
              </div>
              <div style="padding:1.25rem;">
                <h3 style="font-family:var(--font-heading);font-size:1rem;font-weight:700;color:var(--color-maroon);margin-bottom:0.5rem;">{{ card_title | escape }}</h3>
                {%- if block.settings.description != blank -%}
                  <p style="font-size:12px;color:rgba(45,45,45,0.65);line-height:1.65;margin-bottom:0.75rem;">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:var(--color-maroon);display:inline-flex;align-items:center;gap:5px;">
                  Shop Now
                  <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </span>
              </div>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Boutique Saree Grid",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Shop By Type" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Saree Collections" },
    { "type": "textarea", "id": "subtext", "label": "Subtext (optional)" }
  ],
  "blocks": [
    {
      "type": "saree_type",
      "name": "Saree type card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Card image (optional override)", "info": "If left blank, falls back to the collection's own image, then to its first product's image." },
        { "type": "text", "id": "title", "label": "Title override (optional)", "info": "Leave blank to use the collection's own title." },
        { "type": "textarea", "id": "description", "label": "One-line description (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Boutique Saree Grid" }
  ]
}
{% endschema %}
