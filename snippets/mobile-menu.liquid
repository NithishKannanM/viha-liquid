{%- comment -%} Mobile Menu Drawer — rendered once per page via layout/theme.liquid {%- endcomment -%}
<div class="mobile-menu-overlay" aria-hidden="true"></div>

<nav id="mobile-menu" class="mobile-menu" role="dialog" aria-label="Mobile navigation" aria-modal="true">
  <div class="mobile-menu__header">
    <a href="/" aria-label="{{ shop.name }} home">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" height="{{ settings.logo_height_mobile }}" style="height:{{ settings.logo_height_mobile }}px;">
      {% else %}
        <span style="font-family:var(--font-heading);font-weight:900;color:var(--color-maroon);">{{ shop.name }}</span>
      {% endif %}
    </a>
    <button class="header__icon-btn" data-mobile-menu-close aria-label="Close menu">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="mobile-menu__body">

    {%- comment -%} First item deliberately: "where is my order" is a top reason returning
        customers reopen the site, and 88% of sessions are mobile. {%- endcomment -%}
    <a href="/pages/track-order" class="mobile-menu__link mobile-menu__link--track">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h.375c.621 0 1.125-.504 1.125-1.125V14.25m-17.25 0h16.5m-16.5 0V6.375c0-.621.504-1.125 1.125-1.125h9.75c.621 0 1.125.504 1.125 1.125v3M17.25 14.25V9.375c0-.621.504-1.125 1.125-1.125h1.06c.38 0 .735.192.943.512l1.416 2.183c.123.19.188.41.188.635v2.67"/>
      </svg>
      Track My Order
    </a>

    <div class="mobile-menu__divider"></div>

    {%- comment -%} Departments come from the header section's nav_item blocks (same
        blocks that drive the desktop nav strip + mega menu). The first `mobile_group1_count` items =
        "Shop Collections", the rest = "More Categories". The count is a header section setting. {%- endcomment -%}
    {%- assign mobile_nav_blocks = nav_blocks | default: section.blocks -%}
    {%- assign mobile_group1_count_plus_one = mobile_group1_count | default: 9 | plus: 1 -%}
    <p class="mobile-menu__section-label">{{ mobile_group1_label | default: "Shop Collections" | escape }}</p>
    {%- for block in mobile_nav_blocks -%}
      {%- if block.type == 'nav_item' -%}
        {%- if forloop.index == mobile_group1_count_plus_one -%}
    <div class="mobile-menu__divider"></div>

    <p class="mobile-menu__section-label">{{ mobile_group2_label | default: "More Categories" | escape }}</p>
        {%- endif -%}
        {%- comment -%} A nav_item with a mega menu opens in place: a banner for the whole
            department (the only way to reach the department page on a phone, since the
            row itself only toggles), then its menu links as picture tiles. Items without
            a mega menu stay plain links. {%- endcomment -%}
        {%- assign mm_links = blank -%}
        {%- if block.settings.mega_menu != blank -%}
          {%- assign mm_links = linklists[block.settings.mega_menu].links -%}
        {%- endif -%}
        {%- if mm_links != blank and mm_links.size > 0 -%}
    <details class="mobile-menu__group">
      <summary class="mobile-menu__link mobile-menu__summary">
        <span>{{ block.settings.label | escape }}</span>
        <svg class="mobile-menu__chevron" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="mobile-menu__panel">
        {%- assign banner_img = blank -%}
        {%- if block.settings.link contains '/collections/' -%}
          {%- assign tab_handle = block.settings.link | split: '/collections/' | last | split: '/' | first | split: '?' | first -%}
          {%- assign banner_img = collections[tab_handle].featured_image -%}
        {%- endif -%}
        {%- if banner_img == blank and mm_links.first.type == 'collection_link' -%}
          {%- assign banner_img = mm_links.first.object.featured_image -%}
        {%- endif -%}
        <a href="{{ block.settings.link | escape }}" class="mobile-menu__banner">
          {%- if banner_img != blank -%}
          <img src="{{ banner_img | image_url: width: 640 }}" alt="" loading="lazy" width="640" height="240">
          {%- endif -%}
          <span class="mobile-menu__banner-label">{{ block.settings.label | escape }}</span>
        </a>
        {%- assign mm_has_columns = false -%}
        {%- for link in mm_links -%}{%- if link.links.size > 0 -%}{%- assign mm_has_columns = true -%}{%- endif -%}{%- endfor -%}
        {%- if mm_has_columns -%}
          {%- for link in mm_links -%}
            {%- if link.url == '#' or link.url == blank -%}
        <p class="mobile-menu__col-heading">{{ link.title | escape }}</p>
            {%- else -%}
        <a href="{{ link.url }}" class="mobile-menu__col-heading">{{ link.title | escape }}</a>
            {%- endif -%}
            {%- if link.links.size > 0 -%}
        <ul class="mobile-menu__tiles">
              {%- for child in link.links -%}
          <li>{% render 'mobile-menu-tile', link: child %}</li>
              {%- endfor -%}
        </ul>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
        <ul class="mobile-menu__tiles">
          {%- for link in mm_links -%}
          <li>{% render 'mobile-menu-tile', link: link %}</li>
          {%- endfor -%}
        </ul>
        {%- endif -%}
      </div>
    </details>
        {%- else -%}
    <a href="{{ block.settings.link | escape }}" class="mobile-menu__link{% if block.settings.highlight %} mobile-menu__link--gold{% elsif block.settings.badge != blank %} mobile-menu__link--beauty{% endif %}">
      {{- block.settings.label | escape -}}
      {%- if block.settings.highlight -%}
        {%- if block.settings.badge != blank %} {{ block.settings.badge | escape }}{% endif -%}
      {%- elsif block.settings.badge != blank -%}
      <span class="mobile-menu__badge mobile-menu__badge--green">{{ block.settings.badge | escape }} Featured</span>
      {%- endif -%}
    </a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

  </div>

  <div class="mobile-menu__footer">
    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-menu__footer-link">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
      </svg>
      My Account
    </a>
  </div>
</nav>
