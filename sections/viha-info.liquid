{%- comment -%}
  Viha info: the delivery note that used to be the welcome popup (shown on every screen size), plus, on phones only,
  the customer care number first, the Viha app links, and a WhatsApp button (wholesale and concerts) last with install steps (they leave the phone header to make room for the
  founder photo). Every text, number and link is a setting below.
{%- endcomment -%}
<section class="section viha-info" aria-labelledby="viha-info-heading">
  <div class="container viha-info__inner">
    {%- comment -%} Customer care first (phones): the number customers should call. {%- endcomment -%}
    {%- if section.settings.cc_phone != blank -%}
      {%- assign cc_digits = section.settings.cc_phone | remove: ' ' | remove: '-' -%}
      {%- if cc_digits.size == 10 -%}{%- assign cc_digits = '+91' | append: cc_digits -%}{%- endif -%}
      <div class="viha-info__card viha-info__cc">
        {%- if section.settings.cc_heading != blank -%}<h3 class="viha-info__card-title">{{ section.settings.cc_heading }}</h3>{%- endif -%}
        <a class="viha-info__cc-number" href="tel:{{ cc_digits }}">{{ section.settings.cc_phone }}</a>
        {%- if section.settings.cc_text != blank -%}<p class="viha-info__cc-text">{{ section.settings.cc_text }}</p>{%- endif -%}
        <a class="btn btn--primary viha-info__btn" href="tel:{{ cc_digits }}">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          {{ section.settings.cc_button_label }}
        </a>
      </div>
    {%- endif -%}
    <div class="viha-info__note">
      {%- if section.settings.eyebrow != blank -%}<p class="section__eyebrow viha-info__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="viha-info__title font-serif" id="viha-info-heading">{{ section.settings.heading }}</h2>
      <span class="viha-info__rule" aria-hidden="true"></span>
      <div class="viha-info__body rte">{{ section.settings.body }}</div>
    </div>

    {%- assign show_call = false -%}
    {%- if section.settings.call_phone != blank -%}{%- assign show_call = true -%}{%- endif -%}
    {%- assign show_app = false -%}
    {%- if section.settings.play_store_url != blank or section.settings.app_store_url != blank -%}{%- assign show_app = true -%}{%- endif -%}

    {%- if show_call or show_app -%}
    <div class="viha-info__mobile">
      {%- if show_app -%}
        <div class="viha-info__card">
          {%- if section.settings.app_heading != blank -%}<h3 class="viha-info__card-title">{{ section.settings.app_heading }}</h3>{%- endif -%}
          {%- if section.settings.app_steps != blank -%}<div class="viha-info__card-text rte">{{ section.settings.app_steps }}</div>{%- endif -%}
          <div class="viha-info__app-btns">
            {%- if section.settings.play_store_url != blank -%}
            <a class="btn btn--primary viha-info__btn" href="{{ section.settings.play_store_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get the Viha app on Google Play (opens in a new tab)">Android</a>
            {%- endif -%}
            {%- if section.settings.app_store_url != blank -%}
            <a class="btn btn--outline-maroon viha-info__btn" href="{{ section.settings.app_store_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get the Viha app on the App Store (opens in a new tab)">iPhone</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if show_call -%}
        {%- assign wa_digits = section.settings.call_phone | remove: ' ' | remove: '-' | remove: '+' -%}
        {%- if wa_digits.size == 10 -%}{%- assign wa_digits = '91' | append: wa_digits -%}{%- endif -%}
        <div class="viha-info__card">
          {%- if section.settings.call_heading != blank -%}<h3 class="viha-info__card-title">{{ section.settings.call_heading }}</h3>{%- endif -%}
          {%- if section.settings.call_text != blank -%}<p class="viha-info__card-text">{{ section.settings.call_text }}</p>{%- endif -%}
          <a class="btn btn--primary viha-info__btn" href="https://wa.me/{{ wa_digits }}{% if section.settings.whatsapp_message != blank %}?text={{ section.settings.whatsapp_message | url_encode }}{% endif %}" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.call_button_label | escape }} {{ section.settings.call_phone | escape }} (opens WhatsApp)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
            {{ section.settings.call_button_label }} {{ section.settings.call_phone }}
          </a>
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>

<style>
.viha-info { background: var(--color-cream, #FDF9F1); }
.viha-info__inner { max-width: 760px; margin: 0 auto; }
.viha-info__note { text-align: center; border-top: 3px solid var(--color-gold); background: #fff; padding: 2rem 1.75rem 1.5rem; border-radius: 3px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); }
.viha-info__eyebrow { margin-bottom: 6px; }
.viha-info__title { font-size: clamp(20px, 3vw, 26px); color: var(--color-maroon); margin: 0 0 0.75rem; }
.viha-info__rule { display: inline-block; width: 48px; height: 2px; background: var(--color-gold); margin-bottom: 1rem; }
.viha-info__body { font-size: 14px; line-height: 1.8; color: var(--color-charcoal); text-align: left; }
.viha-info__body p { margin: 0 0 0.75rem; }
.viha-info__body p:last-child { margin-bottom: 0; }
.viha-info__body strong { color: var(--color-maroon); }
.viha-info__mobile, .viha-info__cc { display: none; }
.viha-info__cc { margin-bottom: 1rem; }
.viha-info__cc-number { display: block; font-family: var(--font-heading); font-size: 28px; font-weight: 900; color: var(--color-maroon); text-decoration: none; letter-spacing: 0.02em; margin: 0.25rem 0 0.35rem; }
.viha-info__cc-text { font-size: 14px; color: var(--color-charcoal); margin: 0 0 1rem; }
@media (max-width: 767px) {
  .viha-info__mobile { display: grid; gap: 1rem; margin-top: 1rem; }
  .viha-info__cc { display: block; }
  .viha-info__note { padding: 1.5rem 1.25rem 1.25rem; }
}
.viha-info__card { background: #fff; border: 1px solid rgba(184,137,61,0.35); border-radius: 6px; padding: 1.25rem; text-align: center; }
.viha-info__card-title { font-family: var(--font-heading); font-size: 18px; color: var(--color-maroon); margin: 0 0 0.5rem; }
.viha-info__card-text { font-size: 14px; line-height: 1.7; color: var(--color-charcoal); margin: 0 0 1rem; text-align: left; }
.viha-info__card-text ol, .viha-info__card-text ul { margin: 0; padding-left: 1.25rem; }
.viha-info__btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; min-height: 48px; }
.viha-info__app-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
</style>

{% schema %}
{
  "name": "Viha info",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Delivery note (all screens)" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A note from Viha" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery Time" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "header", "content": "Customer care (phones only, shown first)", "info": "Leave the number empty to hide this card." },
    { "type": "text", "id": "cc_heading", "label": "Heading", "default": "Customer Care Number" },
    { "type": "text", "id": "cc_phone", "label": "Phone number" },
    { "type": "text", "id": "cc_text", "label": "Short text" },
    { "type": "text", "id": "cc_button_label", "label": "Button label", "default": "Call Customer Care" },
    { "type": "header", "content": "WhatsApp us (phones only)", "info": "Leave the number empty to hide this card." },
    { "type": "text", "id": "call_heading", "label": "Heading", "default": "WhatsApp us" },
    { "type": "text", "id": "call_text", "label": "Short text" },
    { "type": "text", "id": "call_phone", "label": "WhatsApp number", "info": "Shown on the button; 10-digit Indian numbers get 91 added for the WhatsApp link" },
    { "type": "text", "id": "whatsapp_message", "label": "Pre-filled WhatsApp message" },
    { "type": "text", "id": "call_button_label", "label": "Button label", "default": "WhatsApp" },
    { "type": "header", "content": "Viha app (phones only)", "info": "Leave both links empty to hide this card." },
    { "type": "text", "id": "app_heading", "label": "Heading", "default": "Get the Viha App" },
    { "type": "richtext", "id": "app_steps", "label": "How to install" },
    { "type": "url", "id": "play_store_url", "label": "Google Play link" },
    { "type": "url", "id": "app_store_url", "label": "App Store link" }
  ],
  "presets": [{ "name": "Viha info" }]
}
{% endschema %}
