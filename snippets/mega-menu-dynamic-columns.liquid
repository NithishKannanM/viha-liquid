{%- comment -%}
  Mega Menu — dynamic columns
  ---------------------------
  Renders a mega-menu panel's subcategory columns from a client-picked
  navigation menu instead of the section's hardcoded markup. Used by
  sections/header.liquid once per nav_item block whose `mega_menu` setting
  is set; the block's `mega_panel` fallback markup stays in header.liquid
  untouched when this isn't used.

  Menu structure expected: each top-level link in the picked menu becomes a
  column heading; that link's own sub-links become the column's links.
  Column description text comes from the block's col1_desc…col6_desc
  settings (Shopify menus have no description field of their own), matched
  to the column by position, capped at 6 columns.

  Accepts: block (a nav_item block whose settings.mega_menu is set)
{%- endcomment -%}

{%- assign mm_menu = linklists[block.settings.mega_menu] -%}
<div class="mega-menu__subcats">
  {%- for heading_link in mm_menu.links limit: 6 -%}
    <div>
      <p class="mega-menu__cat-heading">{{ heading_link.title | escape }}</p>
      {%- assign mm_desc = '' -%}
      {%- case forloop.index -%}
        {%- when 1 -%}{%- assign mm_desc = block.settings.col1_desc -%}
        {%- when 2 -%}{%- assign mm_desc = block.settings.col2_desc -%}
        {%- when 3 -%}{%- assign mm_desc = block.settings.col3_desc -%}
        {%- when 4 -%}{%- assign mm_desc = block.settings.col4_desc -%}
        {%- when 5 -%}{%- assign mm_desc = block.settings.col5_desc -%}
        {%- when 6 -%}{%- assign mm_desc = block.settings.col6_desc -%}
      {%- endcase -%}
      {%- if mm_desc != blank -%}<p class="mega-menu__cat-desc">{{ mm_desc | escape }}</p>{%- endif -%}
      {%- for gl in heading_link.links -%}
        <a href="{{ gl.url }}" class="mega-menu__cat-link">{{ gl.title | escape }}</a>
      {%- endfor -%}
    </div>
  {%- endfor -%}
</div>
