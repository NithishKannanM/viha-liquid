{%- comment -%} Beauty page "Shop by Concern" — each card is a block: title, icon choice, collection {%- endcomment -%}
<section style="padding:5rem 3rem;background:var(--color-cream);">
  <div style="max-width:var(--max-w);margin:0 auto;">
    <div style="text-align:center;margin-bottom:3rem;">
      {%- if section.settings.eyebrow != blank -%}
      <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.2em;color:var(--color-gold);margin-bottom:0.75rem;">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 style="font-family:var(--font-heading);font-size:clamp(1.5rem,3vw,2.25rem);font-weight:900;color:var(--color-maroon);">{{ section.settings.heading | default: 'Shop by Concern' }}</h2>
      <div class="section__ornament" style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:1rem;">
        <div class="section__ornament-line section__ornament-line--left"></div>
        <div class="section__ornament-diamond"></div>
        <div class="section__ornament-line section__ornament-line--right"></div>
      </div>
    </div>

    <div class="concern-card-wrap" style="display:grid;gap:20px;">
      {%- for block in section.blocks -%}
        {%- assign concern_col = collections[block.settings.collection] -%}
        {%- assign tile_img = concern_col.image | default: concern_col.products.first.featured_image -%}
        <a href="{{ concern_col.url | default: '#' }}" class="concern-card" {{ block.shopify_attributes }}>
          <div class="concern-card__img">
            {%- if tile_img != blank -%}
              <img src="{{ tile_img | image_url: width: 600 }}" srcset="{{ tile_img | image_url: width: 400 }} 400w, {{ tile_img | image_url: width: 600 }} 600w" sizes="(min-width:1024px) 25vw, 50vw" alt="{{ tile_img.alt | default: block.settings.title | escape }}" width="600" height="600" loading="lazy">
            {%- endif -%}
          </div>
          <p class="concern-card__title">{{ block.settings.title }}</p>
          <p class="concern-card__count">{{ concern_col.products_count | default: 0 }} product{{ concern_col.products_count | pluralize: "", "s" }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.concern-card-wrap { grid-template-columns: repeat(2,1fr); }
@media (min-width:768px) { .concern-card-wrap { grid-template-columns: repeat(4,1fr); gap: 28px; } }
.concern-card { display:block; text-decoration:none; color:var(--color-charcoal); }
.concern-card__img { aspect-ratio:1/1; overflow:hidden; background:var(--color-paper); }
.concern-card__img img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
.concern-card:hover .concern-card__img img, .concern-card:focus-visible .concern-card__img img { transform:scale(1.04); }
.concern-card__title { font-family:var(--font-heading); font-size:clamp(1rem,1.6vw,1.2rem); font-weight:800; color:var(--color-maroon); margin-top:12px; line-height:1.25; }
.concern-card__count { font-size:14px; color:var(--color-charcoal); margin-top:2px; }
@media (prefers-reduced-motion: reduce) { .concern-card__img img { transition:none; } }
</style>

{% schema %}
{
  "name": "Beauty Shop by Concern",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Personalised Care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Concern" }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Dry Skin" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "filter", "label": "Filter" },
            { "value": "clock", "label": "Clock" },
            { "value": "sun", "label": "Sun" },
            { "value": "heart", "label": "Heart" },
            { "value": "moon", "label": "Moon" },
            { "value": "arrow-up", "label": "Arrow up" }
          ],
          "default": "droplet"
        },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty Shop by Concern",
      "blocks": [
        { "type": "concern", "settings": { "title": "Dry Skin", "icon": "droplet" } },
        { "type": "concern", "settings": { "title": "Radiant Glow", "icon": "sparkle" } },
        { "type": "concern", "settings": { "title": "Acne & Blemishes", "icon": "filter" } },
        { "type": "concern", "settings": { "title": "Anti-Aging", "icon": "clock" } },
        { "type": "concern", "settings": { "title": "Oily Skin", "icon": "sun" } },
        { "type": "concern", "settings": { "title": "Sensitive Skin", "icon": "heart" } },
        { "type": "concern", "settings": { "title": "Night Repair", "icon": "moon" } },
        { "type": "concern", "settings": { "title": "Scalp Health", "icon": "arrow-up" } }
      ]
    }
  ]
}
{% endschema %}
