{%- assign wcb_has_wholesale = false -%}
{%- assign wcb_has_concert = false -%}
{%- if section.settings.wholesale_whatsapp_number != blank -%}{%- assign wcb_has_wholesale = true -%}{%- endif -%}
{%- if section.settings.concert_whatsapp_number != blank -%}{%- assign wcb_has_concert = true -%}{%- endif -%}

{%- comment -%}
  Nothing is rendered until at least one WhatsApp number is configured below,
  so this never shows an empty section or a placeholder number to a visitor.
{%- endcomment -%}
{%- if wcb_has_wholesale or wcb_has_concert -%}
<section class="section section--paper whatsapp-contact-banner" aria-labelledby="whatsapp-contact-heading">
  <div class="container" style="text-align:center;">
    {%- if section.settings.eyebrow != blank -%}
    <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="section__heading" id="whatsapp-contact-heading">{{ section.settings.heading | default: 'Wholesale Orders & Concert Booking' }}</h2>
    <div class="section__ornament" aria-hidden="true">
      <div class="section__ornament-line section__ornament-line--left"></div>
      <div class="section__ornament-diamond"></div>
      <div class="section__ornament-line section__ornament-line--right"></div>
    </div>
    {% if section.settings.subtext != blank %}
      <p style="max-width:42rem;margin:1rem auto 0;font-size:14px;color:rgba(45,45,45,0.7);line-height:1.75;">{{ section.settings.subtext }}</p>
    {% endif %}

    <div class="whatsapp-contact-banner__cards">
      {%- if wcb_has_wholesale -%}
        {%- assign wcb_wholesale_digits = section.settings.wholesale_whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
        <a href="https://wa.me/{{ wcb_wholesale_digits }}?text={{ section.settings.wholesale_whatsapp_message | default: 'Hi, I would like to know more about wholesale orders.' | url_encode }}"
           class="whatsapp-contact-banner__card" target="_blank" rel="noopener">
          <span class="whatsapp-contact-banner__icon" aria-hidden="true">
            <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M2.25 6.338c0 5.487 4.575 9.975 10.222 9.975 1.584 0 3.085-.37 4.42-1.03l3.358.838-.838-3.358A9.826 9.826 0 0021.75 8.25c0-5.487-4.576-9.975-10.222-9.975-5.647 0-9.278 4.488-9.278 9.975v.088z"/></svg>
          </span>
          <span class="whatsapp-contact-banner__label">{{ section.settings.wholesale_whatsapp_label | default: 'Wholesale Enquiries' }}</span>
          {% if section.settings.wholesale_whatsapp_subtext != blank %}
            <span class="whatsapp-contact-banner__desc">{{ section.settings.wholesale_whatsapp_subtext }}</span>
          {% endif %}
        </a>
      {%- endif -%}

      {%- if wcb_has_concert -%}
        {%- assign wcb_concert_digits = section.settings.concert_whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
        <a href="https://wa.me/{{ wcb_concert_digits }}?text={{ section.settings.concert_whatsapp_message | default: 'Hi, I would like to enquire about a concert booking.' | url_encode }}"
           class="whatsapp-contact-banner__card" target="_blank" rel="noopener">
          <span class="whatsapp-contact-banner__icon" aria-hidden="true">
            <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M2.25 6.338c0 5.487 4.575 9.975 10.222 9.975 1.584 0 3.085-.37 4.42-1.03l3.358.838-.838-3.358A9.826 9.826 0 0021.75 8.25c0-5.487-4.576-9.975-10.222-9.975-5.647 0-9.278 4.488-9.278 9.975v.088z"/></svg>
          </span>
          <span class="whatsapp-contact-banner__label">{{ section.settings.concert_whatsapp_label | default: 'Concert Booking' }}</span>
          {% if section.settings.concert_whatsapp_subtext != blank %}
            <span class="whatsapp-contact-banner__desc">{{ section.settings.concert_whatsapp_subtext }}</span>
          {% endif %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .whatsapp-contact-banner__cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .whatsapp-contact-banner__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 260px;
    max-width: 100%;
    padding: 1.75rem 1.5rem;
    border-radius: 4px;
    background: var(--color-paper);
    text-decoration: none;
    color: var(--color-charcoal);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .whatsapp-contact-banner__card:hover {
    border-color: #25D366;
  }
  .whatsapp-contact-banner__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
  }
  .whatsapp-contact-banner__label {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--color-maroon);
  }
  .whatsapp-contact-banner__desc {
    font-size: 12px;
    color: rgba(45,45,45,0.65);
    line-height: 1.6;
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp Contact Banner",
  "settings": [
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text",     "id": "heading",  "label": "Heading", "default": "Wholesale Orders & Concert Booking" },
    { "type": "textarea", "id": "subtext",  "label": "Subtext" },

    { "type": "header",   "content": "Wholesale" },
    { "type": "text",     "id": "wholesale_whatsapp_number",  "label": "Wholesale WhatsApp number", "info": "Include country code, e.g. 919876543210. Leave blank to hide this card." },
    { "type": "text",     "id": "wholesale_whatsapp_label",   "label": "Wholesale card label", "default": "Wholesale Enquiries" },
    { "type": "text",     "id": "wholesale_whatsapp_subtext", "label": "Wholesale card short description" },
    { "type": "text",     "id": "wholesale_whatsapp_message", "label": "Wholesale pre-filled message", "default": "Hi, I would like to know more about wholesale orders." },

    { "type": "header",   "content": "Concert booking" },
    { "type": "text",     "id": "concert_whatsapp_number",    "label": "Concert booking WhatsApp number", "info": "Include country code, e.g. 919876543210. Leave blank to hide this card." },
    { "type": "text",     "id": "concert_whatsapp_label",     "label": "Concert booking card label", "default": "Concert Booking" },
    { "type": "text",     "id": "concert_whatsapp_subtext",   "label": "Concert booking card short description" },
    { "type": "text",     "id": "concert_whatsapp_message",   "label": "Concert booking pre-filled message", "default": "Hi, I would like to enquire about a concert booking." }
  ],
  "presets": [
    { "name": "WhatsApp Contact Banner", "category": "Promotional" }
  ]
}
{% endschema %}
