{% if section.settings.enabled %}
<div class="announcement-bar" role="banner" aria-label="Shipping announcement" id="announcement-bar">
  {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank -%}
  <ul class="announcement-bar__social" aria-label="Viha on social media">
    {%- if settings.social_facebook_link != blank -%}
    <li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Viha on Facebook (opens in a new tab)">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg>
    </a></li>
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
    <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Viha on Instagram (opens in a new tab)">
      <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    </a></li>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
    <li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="Viha on YouTube (opens in a new tab)">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg>
    </a></li>
    {%- endif -%}
  </ul>
  {%- endif -%}

  <span class="announcement-bar__text">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" style="color:inherit;text-decoration:none;">{%- endif -%}
    {{ section.settings.text }} | Ships to: {{ localization.country.name }} ({{ localization.country.currency.iso_code }})
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </span>

  {%- if section.settings.play_store_url != blank or section.settings.app_store_url != blank -%}
  <div class="announcement-bar__app">
    {%- if section.settings.app_label != blank -%}<span class="announcement-bar__app-label">{{ section.settings.app_label }}</span>{%- endif -%}
    {%- if section.settings.play_store_url != blank -%}
    <a href="{{ section.settings.play_store_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get the Viha app on Google Play (opens in a new tab)">Android</a>
    {%- endif -%}
    {%- if section.settings.app_store_url != blank -%}
    <a href="{{ section.settings.app_store_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get the Viha app on the App Store (opens in a new tab)">iPhone</a>
    {%- endif -%}
    {%- if section.settings.qr_image != blank -%}
    <span class="announcement-bar__qr" tabindex="0" aria-label="QR code to install the Viha app">
      {{ section.settings.qr_image | image_url: width: 64 | image_tag: width: 22, height: 22, alt: '', class: 'announcement-bar__qr-thumb' }}
      <span class="announcement-bar__qr-pop" role="tooltip">
        {{ section.settings.qr_image | image_url: width: 320 | image_tag: width: 140, height: 140, alt: section.settings.qr_image.alt, loading: 'lazy' }}
        {%- if section.settings.qr_caption != blank -%}<span>{{ section.settings.qr_caption }}</span>{%- endif -%}
      </span>
    </span>
    {%- endif -%}
  </div>
  {%- endif -%}

  <button data-announcement-close aria-label="Close announcement" style="background:none;border:none;color:rgba(255,255,255,0.5);padding:0 0.25rem;cursor:pointer;font-size:16px;line-height:1;margin-left:0.5rem;">&times;</button>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "text", "label": "Announcement text", "default": "Ships pan-India & worldwide, rates calculated at checkout." },
    { "type": "url", "id": "link", "label": "Announcement link (optional)" },
    { "type": "header", "content": "Social icons", "info": "Facebook, Instagram and YouTube links come from Theme settings > Social media." },
    { "type": "header", "content": "Viha app" },
    { "type": "text", "id": "app_label", "label": "App label", "default": "Get the Viha app:" },
    { "type": "url", "id": "play_store_url", "label": "Google Play link", "info": "Leave empty to hide the Android link" },
    { "type": "url", "id": "app_store_url", "label": "App Store link", "info": "Leave empty to hide the iPhone link" },
    { "type": "image_picker", "id": "qr_image", "label": "App QR code", "info": "Shown on hover on computers; hidden on phones" },
    { "type": "text", "id": "qr_caption", "label": "QR caption", "default": "Scan to install (Android)" }
  ]
}
{% endschema %}
