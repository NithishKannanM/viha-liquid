{%- comment -%} Mega-menu "featured" tile pulls the latest post from the "news" blog (same article in every panel) {%- endcomment -%}
{%- assign mega_blog_article = blogs['news'].articles.first -%}
{%- assign mega_blog_img = mega_blog_article.image | img_url: '100x100' -%}
{%- assign mega_blog_date = mega_blog_article.published_at | date: '%b %d, %Y' -%}
{%- assign mega_blog_excerpt = mega_blog_article.excerpt | strip_html | strip_newlines -%}
{%- if mega_blog_excerpt == blank -%}
  {%- assign mega_blog_excerpt = mega_blog_article.content | strip_html | strip_newlines | truncate: 100 -%}
{%- endif -%}

<header class="site-header" role="banner">

  {%- comment -%} ── Row 1: Logo + Tagline + Utility Icons ─────────────── {%- endcomment -%}
  <div class="header__row-1">

    {%- comment -%} Mobile hamburger (left) {%- endcomment -%}
    <button class="header__icon-btn lg:hidden" data-mobile-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
      </svg>
    </button>

    <div class="header__brand">
    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} home">
      {% if settings.logo != blank %}
        {%- comment -%} Height via custom property (not inline height) so the
          mobile media query in theme.css can still shrink the logo. {%- endcomment -%}
        <img
          src="{{ settings.logo | image_url: width: 600 }}"
          srcset="{{ settings.logo | image_url: width: 300 }} 300w, {{ settings.logo | image_url: width: 600 }} 600w"
          sizes="{{ settings.logo_height | default: 70 | times: 2 }}px"
          alt="{{ shop.name }}"
          width="{{ settings.logo_height | default: 70 | times: settings.logo.aspect_ratio | round }}"
          height="{{ settings.logo_height }}"
          style="--logo-h:{{ settings.logo_height | default: 70 }}px; --logo-h-mobile:{{ settings.logo_height_mobile | default: 48 }}px;"
          loading="eager"
          fetchpriority="high"
        >
      {% else %}
        <span class="header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>
    {%- comment -%} Founder photo beside the logo (Meha, 25 Oct): links to Our Story. Hidden on phones, where the
      logo is centred between the menu and icon buttons. {%- endcomment -%}
    {%- if section.settings.founder_photo != blank -%}
    <a href="{{ section.settings.founder_link | default: '/pages/our-story' | escape }}" class="header__founder">
      {{ section.settings.founder_photo | image_url: width: 200 | image_tag: width: 72, height: 72, widths: '100, 200', sizes: '72px', alt: section.settings.founder_photo.alt, loading: 'eager', class: 'header__founder-img' }}
      {%- if section.settings.founder_name != blank -%}
      <span class="header__founder-text">
        <span class="header__founder-name">{{ section.settings.founder_name | escape }}</span>
        {%- if section.settings.founder_role != blank -%}<span class="header__founder-role">{{ section.settings.founder_role | escape }}</span>{%- endif -%}
      </span>
      {%- endif -%}
    </a>
    {%- endif -%}
    </div>

    {%- comment -%} Centre tagline (desktop only) {%- endcomment -%}
    {%- if section.settings.show_tagline -%}
    <div class="header__tagline" aria-hidden="true">
      <span class="header__tagline-brand">{{ section.settings.tagline_brand | escape }}</span>
      <span class="header__tagline-sub">{{ section.settings.tagline_sub | escape }}</span>
    </div>
    {%- endif -%}

    {%- comment -%} Right icon group {%- endcomment -%}
    <div class="header__icons">

      {%- comment -%} Track my order — the page itself already does the real work (courier blocks +
          prefix matcher in sections/track-order-page.liquid); it was just unreachable from the
          header. Label shows from 1180px up, icon-only below. {%- endcomment -%}
      {%- if section.settings.show_track -%}
      <a href="{{ section.settings.track_link | escape }}" class="header__track" aria-label="Track my order">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h.375c.621 0 1.125-.504 1.125-1.125V14.25m-17.25 0h16.5m-16.5 0V6.375c0-.621.504-1.125 1.125-1.125h9.75c.621 0 1.125.504 1.125 1.125v3M17.25 14.25V9.375c0-.621.504-1.125 1.125-1.125h1.06c.38 0 .735.192.943.512l1.416 2.183c.123.19.188.41.188.635v2.67"/>
        </svg>
        <span class="header__track-label" aria-hidden="true">{{ section.settings.track_label | escape }}</span>
      </a>
      {%- endif -%}

      {%- comment -%} Wholesale & concert booking phone: a tap-to-call link beside Track My Order. {%- endcomment -%}
      {%- if section.settings.booking_phone != blank -%}
        {%- assign booking_digits = section.settings.booking_phone | remove: ' ' | remove: '-' -%}
        {%- if booking_digits.size == 10 -%}{%- assign booking_digits = '+91' | append: booking_digits -%}{%- endif -%}
        <a href="tel:{{ booking_digits }}" class="header__track header__booking" aria-label="{{ section.settings.booking_label | escape }}: {{ section.settings.booking_phone | escape }}">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
          </svg>
          <span class="header__track-label" aria-hidden="true">{{ section.settings.booking_label | escape }} <strong>{{ section.settings.booking_phone | escape }}</strong></span>
        </a>
      {%- endif -%}

      {%- comment -%} Viha app: Android + iPhone links with a QR on hover (desktop); on phones one "App" button
          that opens the store for that phone (iPhone -> App Store, otherwise Google Play). {%- endcomment -%}
      {%- if section.settings.play_store_url != blank or section.settings.app_store_url != blank -%}
      <div class="header__app">
        {%- if section.settings.qr_image != blank -%}
        <span class="header__app-qr" tabindex="0" aria-label="QR code to install the Viha app">
          {{ section.settings.qr_image | image_url: width: 96 | image_tag: width: 34, height: 34, alt: '', class: 'header__app-qr-thumb' }}
          <span class="header__app-qr-pop" role="tooltip">
            {{ section.settings.qr_image | image_url: width: 360 | image_tag: width: 160, height: 160, alt: section.settings.qr_image.alt }}
            {%- if section.settings.qr_caption != blank -%}<span>{{ section.settings.qr_caption }}</span>{%- endif -%}
          </span>
        </span>
        {%- endif -%}
        <span class="header__app-text">
          {%- if section.settings.app_label != blank -%}<span class="header__app-label">{{ section.settings.app_label }}</span>{%- endif -%}
          <span class="header__app-links">
            {%- if section.settings.play_store_url != blank -%}<a href="{{ section.settings.play_store_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get the Viha app on Google Play (opens in a new tab)">Android</a>{%- endif -%}
            {%- if section.settings.play_store_url != blank and section.settings.app_store_url != blank -%}<span aria-hidden="true">·</span>{%- endif -%}
            {%- if section.settings.app_store_url != blank -%}<a href="{{ section.settings.app_store_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get the Viha app on the App Store (opens in a new tab)">iPhone</a>{%- endif -%}
          </span>
        </span>
        <a class="header__app-mobile" href="{{ section.settings.play_store_url | default: section.settings.app_store_url }}" data-ios-href="{{ section.settings.app_store_url }}" target="_blank" rel="noopener noreferrer" aria-label="Get the Viha app">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>
          <span>App</span>
        </a>
        <script>
          (function () {
            var a = document.currentScript.previousElementSibling;
            if (a && a.dataset.iosHref && /iPhone|iPad|iPod/.test(navigator.userAgent)) a.href = a.dataset.iosHref;
          })();
        </script>
      </div>
      {%- endif -%}

      {%- comment -%} Wholesale / Concert WhatsApp links — same dormant pattern as the footer and
          homepage banner: each link only renders once its number is filled in below. {%- endcomment -%}
      {%- if section.settings.wholesale_whatsapp_number != blank -%}
        {%- assign header_wholesale_digits = section.settings.wholesale_whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
        <a href="https://wa.me/{{ header_wholesale_digits }}?text={{ section.settings.wholesale_whatsapp_message | default: 'Hi, I would like to know more about wholesale orders.' | url_encode }}"
           class="header__track" target="_blank" rel="noopener" aria-label="{{ section.settings.wholesale_whatsapp_label | default: 'Wholesale Enquiries' }}">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.338c0 5.487 4.575 9.975 10.222 9.975 1.584 0 3.085-.37 4.42-1.03l3.358.838-.838-3.358A9.826 9.826 0 0021.75 8.25c0-5.487-4.576-9.975-10.222-9.975-5.647 0-9.278 4.488-9.278 9.975v.088z"/>
          </svg>
          <span class="header__track-label" aria-hidden="true">{{ section.settings.wholesale_whatsapp_label | default: 'Wholesale Enquiries' }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.concert_whatsapp_number != blank -%}
        {%- assign header_concert_digits = section.settings.concert_whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
        <a href="https://wa.me/{{ header_concert_digits }}?text={{ section.settings.concert_whatsapp_message | default: 'Hi, I would like to book concert tickets.' | url_encode }}"
           class="header__track" target="_blank" rel="noopener" aria-label="{{ section.settings.concert_whatsapp_label | default: 'Book Concert Tickets' }}">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.338c0 5.487 4.575 9.975 10.222 9.975 1.584 0 3.085-.37 4.42-1.03l3.358.838-.838-3.358A9.826 9.826 0 0021.75 8.25c0-5.487-4.576-9.975-10.222-9.975-5.647 0-9.278 4.488-9.278 9.975v.088z"/>
          </svg>
          <span class="header__track-label" aria-hidden="true">{{ section.settings.concert_whatsapp_label | default: 'Book Concert Tickets' }}</span>
        </a>
      {%- endif -%}

      {%- comment -%} Country / currency — read-only display; change it from Account → Region & Currency {%- endcomment -%}
      {%- comment -%} aria-label is prohibited on a plain span (Lighthouse aria-prohibited-attr);
          use visually-hidden text instead. {%- endcomment -%}
      {%- if section.settings.show_country -%}
      <span class="country-badge">
        <span class="sr-only">Shopping from {{ localization.country.name }}, currency {{ localization.country.currency.iso_code }}</span>
        <span aria-hidden="true">{% render 'flag-emoji', code: localization.country.iso_code %}</span>
        <span class="hidden md:inline" aria-hidden="true">{{ localization.country.currency.iso_code }}</span>
      </span>
      {%- endif -%}

      {%- comment -%} Search {%- endcomment -%}
      {%- if section.settings.show_search -%}
      <button class="header__icon-btn" data-search-open aria-label="Search products">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 15.803 7.5 7.5 0 0015.803 15.803z"/>
        </svg>
      </button>
      {%- endif -%}

      {%- comment -%} Account (routes object resolves to Shopify's hosted account UI) {%- endcomment -%}
      {%- if section.settings.show_account -%}
      {%- if customer -%}
        <a href="{{ routes.account_url }}" class="header__icon-btn header__icon-btn--desktop" aria-label="My account">
      {%- else -%}
        <a href="{{ routes.account_login_url }}" class="header__icon-btn header__icon-btn--desktop" aria-label="Sign in">
      {%- endif -%}
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
        </svg>
      </a>
      {%- endif -%}

      {%- comment -%} Wishlist {%- endcomment -%}
      {%- if section.settings.show_wishlist -%}
      <a href="/pages/wishlist" class="header__icon-btn" aria-label="Wishlist">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
        </svg>
      </a>
      {%- endif -%}

      {%- comment -%} Cart {%- endcomment -%}
      {%- if section.settings.show_cart -%}
      {% if settings.cart_type == 'drawer' %}
        <button class="header__icon-btn" data-cart-open aria-label="Open cart ({{ cart.item_count }} items)" aria-expanded="false">
      {% else %}
        <a href="{{ routes.cart_url }}" class="header__icon-btn" aria-label="Cart ({{ cart.item_count }} items)">
      {% endif %}
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"/>
          </svg>
          <span class="header__badge header__badge--maroon" data-cart-badge aria-live="polite" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>{{ cart.item_count }}</span>
      {% if settings.cart_type == 'drawer' %}
        </button>
      {% else %}
        </a>
      {% endif %}
      {%- endif -%}

    </div>{%- comment -%} /.header__icons {%- endcomment -%}
  </div>{%- comment -%} /.header__row-1 {%- endcomment -%}

  {%- comment -%}
    Row 2 — Nav strip: isolated at z-[1] so the mega menu (z-50 inside it)
    can never escape above Row 1 (z-[2]) where the country dropdown lives.
  {%- endcomment -%}
  <nav class="header__row-2" aria-label="Main navigation" id="main-nav">
    {%- comment -%} Viha on social media, in the space under the logo. Links come from Theme settings > Social media. {%- endcomment -%}
    {%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank -%}
    <ul class="header__social" aria-label="Viha on social media">
      {%- if settings.social_facebook_link != blank -%}
      <li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Viha on Facebook (opens in a new tab)">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg>
      </a></li>
      {%- endif -%}
      {%- if settings.social_instagram_link != blank -%}
      <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Viha on Instagram (opens in a new tab)">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a></li>
      {%- endif -%}
      {%- if settings.social_youtube_link != blank -%}
      <li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer" aria-label="Viha on YouTube (opens in a new tab)">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg>
      </a></li>
      {%- endif -%}
    </ul>
    {%- endif -%}
    <div class="header__nav">

      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_item' -%}
        <a
          href="{{ block.settings.link | escape }}"
          class="header__nav-btn{% if block.settings.link == '/collections/all' %} header__nav-btn--all{% endif %}"
          {%- if block.settings.mega_panel != blank %}
          data-mega-trigger="{{ block.settings.mega_panel | escape }}" aria-haspopup="true" aria-expanded="false"
          {%- endif %}
          {%- if block.settings.highlight %}
          style="color:#8A6420;font-weight:900;"
          {%- endif %}
          {{ block.shopify_attributes }}
        >{{- block.settings.label | escape -}}
        {%- if block.settings.badge != blank -%}
          {%- if block.settings.highlight %} {{ block.settings.badge | escape }}
          {%- else %}
          <span style="font-size:8px;background:{{ block.settings.badge_color }};color:#fff;padding:1px 5px;border-radius:2px;margin-left:3px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;vertical-align:middle;">{{ block.settings.badge | escape }}</span>
          {%- endif -%}
        {%- endif -%}</a>
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- comment -%} ── Mega Menu — child of Row 2, so its z-50 is capped by z-[1] parent ─ {%- endcomment -%}
    <div class="mega-menu" role="region" aria-label="Category navigation" aria-live="polite">

      {%- comment -%} SPIRITUAL & POOJA {%- endcomment -%}
      <div data-mega-panel="spiritual-pooja" hidden>
        <div class="mega-menu__inner">
          {%- assign mm_block_spiritual_pooja = nil -%}
          {%- for nav_b in section.blocks -%}{%- if nav_b.settings.mega_panel == 'spiritual-pooja' -%}{%- assign mm_block_spiritual_pooja = nav_b -%}{%- endif -%}{%- endfor -%}
          {%- if mm_block_spiritual_pooja.settings.mega_menu != blank -%}
          {%- render "mega-menu-dynamic-columns", block: mm_block_spiritual_pooja -%}
          {%- else -%}
          <div class="mega-menu__subcats">
            <div>
              <p class="mega-menu__cat-heading">Pooja Essentials</p>
              <p class="mega-menu__cat-desc">Daily worship items</p>
              <a href="{{ routes.collections_url }}/pooja-products" class="mega-menu__cat-link">Pooja Products</a>
              <a href="{{ routes.collections_url }}/pooja-samagri" class="mega-menu__cat-link">Pooja Samagri</a>
              <a href="{{ routes.collections_url }}/lamp-diya" class="mega-menu__cat-link">Lamp &amp; Diya</a>
              <a href="{{ routes.collections_url }}/conch-shells" class="mega-menu__cat-link">Conch Shells</a>
            </div>
            <div>
              <p class="mega-menu__cat-heading">God Idols &amp; Statues</p>
              <p class="mega-menu__cat-desc">Sacred deity figures</p>
              <a href="{{ routes.collections_url }}/statues-idols" class="mega-menu__cat-link">Statues &amp; Idols</a>
              <a href="{{ routes.collections_url }}/god-photos" class="mega-menu__cat-link">God Photos</a>
              <a href="{{ routes.collections_url }}/magnetic-god-photos" class="mega-menu__cat-link">Magnetic God Photos</a>
              <a href="{{ routes.collections_url }}/idol-clothes-ornaments" class="mega-menu__cat-link">Idol Clothes</a>
            </div>
            <div>
              <p class="mega-menu__cat-heading">Crystal &amp; Healing</p>
              <p class="mega-menu__cat-desc">Energy &amp; metaphysical</p>
              <a href="{{ routes.collections_url }}/gemstones-crystals" class="mega-menu__cat-link">Gemstones &amp; Crystals</a>
              <a href="{{ routes.collections_url }}/yantra" class="mega-menu__cat-link">Yantras</a>
              <a href="{{ routes.collections_url }}/vasthu-products" class="mega-menu__cat-link">Vastu Products</a>
              <a href="{{ routes.collections_url }}/mala-rosary" class="mega-menu__cat-link">Mala &amp; Rosary</a>
            </div>
            <div>
              <p class="mega-menu__cat-heading">Karungali Products</p>
              <p class="mega-menu__cat-desc">Sacred ebony wood</p>
              <a href="{{ routes.collections_url }}/karungali" class="mega-menu__cat-link">Karungali Mala</a>
              <a href="{{ routes.collections_url }}/karungali" class="mega-menu__cat-link">Karungali Bracelets</a>
              <a href="{{ routes.collections_url }}/karungali" class="mega-menu__cat-link">Karungali Wood Items</a>
              <a href="{{ routes.collections_url }}/wooden-products" class="mega-menu__cat-link">Wooden Products</a>
            </div>
            <div>
              <p class="mega-menu__cat-heading">Pooja Utensils</p>
              <p class="mega-menu__cat-desc">Brass &amp; copper items</p>
              <a href="{{ routes.collections_url }}/pooja-utensils" class="mega-menu__cat-link">Pooja Utensils</a>
              <a href="{{ routes.collections_url }}/kubera-pooja-products" class="mega-menu__cat-link">Kubera Pooja</a>
              <a href="{{ routes.collections_url }}/kolam-rangoli-stickers-stencils" class="mega-menu__cat-link">Kolam &amp; Rangoli</a>
              <a href="{{ routes.collections_url }}/plain-rudraksh" class="mega-menu__cat-link">Rudraksh Malas</a>
            </div>
            <div>
              <p class="mega-menu__cat-heading">Astrological</p>
              <p class="mega-menu__cat-desc">Vastu &amp; cosmic items</p>
              <a href="{{ routes.collections_url }}/gomathi-chakra" class="mega-menu__cat-link">Gomathi Chakra</a>
              <a href="{{ routes.collections_url }}/pyramid-orgones" class="mega-menu__cat-link">Pyramid &amp; Orgones</a>
              <a href="{{ routes.collections_url }}/vasthu-products" class="mega-menu__cat-link">Vastu Products</a>
              <a href="{{ routes.collections_url }}/gemstones-crystals" class="mega-menu__cat-link">Lucky Stones</a>
            </div>
          </div>
          {%- endif -%}
          <div class="mega-menu__divider" aria-hidden="true"></div>
          <div class="mega-menu__featured">
            {%- if mega_blog_article -%}
            <div>
              <p class="mega-menu__featured-label">FROM THE JOURNAL</p>
              <div style="display:flex;gap:10px;align-items:flex-start;margin-top:0.75rem;">
                {%- if mega_blog_img -%}
                <img class="mega-menu__featured-img" src="{{ mega_blog_img }}" width="48" height="48" alt="{{ mega_blog_article.image.alt | default: mega_blog_article.title | escape }}">
                {%- endif -%}
                <div>
                  <p class="mega-menu__featured-name">{{ mega_blog_article.title }}</p>
                  <p class="mega-menu__featured-date">{{ mega_blog_date }}</p>
                </div>
              </div>
              <p style="font-size:10px;color:rgba(45,45,45,0.6);line-height:1.6;margin-top:8px;">{{ mega_blog_excerpt }}</p>
            </div>
            <a href="{{ mega_blog_article.url }}" class="mega-menu__featured-btn">
              Read Article
              <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            </a>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} CLOTHING: columns come from the nav item's Mega menu (menu "clothing-mega-menu"). {%- endcomment -%}
      <div data-mega-panel="clothing" hidden>
        <div class="mega-menu__inner">
          {%- assign mm_block_clothing = nil -%}
          {%- for nav_b in section.blocks -%}{%- if nav_b.settings.mega_panel == 'clothing' -%}{%- assign mm_block_clothing = nav_b -%}{%- endif -%}{%- endfor -%}
          {%- if mm_block_clothing.settings.mega_menu != blank -%}
          {%- render "mega-menu-dynamic-columns", block: mm_block_clothing -%}
          {%- else -%}
          <div class="mega-menu__subcats">
            <div>
              <p class="mega-menu__cat-heading">Clothing</p>
              <a href="{{ routes.collections_url }}/clothing" class="mega-menu__cat-link">All Clothing</a>
              <a href="{{ routes.collections_url }}/sarees" class="mega-menu__cat-link">Sarees</a>
              <a href="{{ routes.collections_url }}/readymade-garments" class="mega-menu__cat-link">Readymade Garments</a>
            </div>
          </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} SIMPLE LIST PANELS: any nav_item with a mega_menu whose panel key is not one of the
          hardcoded panels above gets one plain list of links (no columns, no journal teaser);
          a menu with nested links (e.g. Wooden Products) renders as grouped columns instead. {%- endcomment -%}
      {%- assign mm_hardcoded_keys = 'spiritual-pooja,clothing' | split: ',' -%}
      {%- for nav_b in section.blocks -%}
        {%- if nav_b.type == 'nav_item' and nav_b.settings.mega_menu != blank and nav_b.settings.mega_panel != blank -%}
          {%- unless mm_hardcoded_keys contains nav_b.settings.mega_panel -%}
      <div data-mega-panel="{{ nav_b.settings.mega_panel | escape }}" hidden>
        <div class="mega-menu__inner mega-menu__inner--simple">
          {%- if linklists[nav_b.settings.mega_menu].levels > 1 -%}
          {%- render "mega-menu-dynamic-columns", block: nav_b -%}
          {%- else -%}
          {%- render "mega-menu-simple-list", block: nav_b -%}
          {%- endif -%}
        </div>
      </div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}

    </div>{%- comment -%} /.mega-menu {%- endcomment -%}
  </nav>{%- comment -%} /.header__row-2 {%- endcomment -%}


</header>

{%- comment -%} ── Mobile Menu Overlay — driven by the same section.blocks as the
    desktop nav strip above, so the two can never list different departments. ── {%- endcomment -%}
{%- render 'mobile-menu', nav_blocks: section.blocks, mobile_group1_label: section.settings.mobile_group1_label, mobile_group2_label: section.settings.mobile_group2_label, mobile_group1_count: section.settings.mobile_group1_count -%}

<style>
.header__brand { display: flex; align-items: center; gap: 16px; }
.header__founder { display: none; align-items: center; gap: 10px; text-decoration: none; padding-left: 16px; border-left: 1px solid rgba(184,137,61,0.35); }
.header__founder-img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: 50% 30%; border: 2px solid var(--color-gold); box-shadow: 0 0 0 3px rgba(184,137,61,0.18); }
.header__founder-text { display: flex; flex-direction: column; line-height: 1.25; }
.header__founder-name { font-family: var(--font-heading); font-size: 14px; font-weight: 700; color: var(--color-maroon); white-space: nowrap; }
.header__founder-role { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #8A6420; white-space: nowrap; }
@media (min-width: 768px) { .header__founder { display: flex; } }
@media (max-width: 1199px) { .header__founder-text { display: none; } }
@media (max-width: 767px) { .header__brand { flex: 1; justify-content: center; } }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Row 1, tagline" },
    { "type": "image_picker", "id": "founder_photo", "label": "Founder photo beside the logo", "info": "Round photo shown next to the logo on tablets and desktop. Leave empty to hide." },
    { "type": "text", "id": "founder_name", "label": "Founder name beside the photo" },
    { "type": "text", "id": "founder_role", "label": "Founder line under the name" },
    { "type": "url", "id": "founder_link", "label": "Founder photo link", "info": "Defaults to the Our Story page." },
    { "type": "checkbox", "id": "show_tagline", "label": "Show centre tagline (desktop only)", "default": true },
    { "type": "text", "id": "tagline_brand", "label": "Tagline, brand line", "default": "Viha Online" },
    { "type": "text", "id": "tagline_sub", "label": "Tagline, sub line", "default": "Spiritual Essentials Curated by Mrs Anitha Kuppusamy" },

    { "type": "header", "content": "Row 1, track my order" },
    { "type": "checkbox", "id": "show_track", "label": "Show Track My Order link", "default": true },
    { "type": "text", "id": "track_label", "label": "Track my order, label", "default": "Track My Order" },
    { "type": "url", "id": "track_link", "label": "Track my order, link", "info": "Defaults to /pages/track-order (set in settings_data.json, the url setting type does not accept a schema default)." },

    { "type": "header", "content": "Row 1: wholesale & concert booking phone" },
    { "type": "text", "id": "booking_phone", "label": "Booking phone number", "info": "Shown beside Track My Order as a tap-to-call link. Leave blank to hide." },
    { "type": "text", "id": "booking_label", "label": "Booking phone label", "default": "Wholesale & Concerts" },
    { "type": "header", "content": "Viha app" },
    { "type": "text", "id": "app_label", "label": "App label", "default": "Get the Viha App" },
    { "type": "url", "id": "play_store_url", "label": "Google Play link", "info": "Leave empty to hide the Android link" },
    { "type": "url", "id": "app_store_url", "label": "App Store link", "info": "Leave empty to hide the iPhone link" },
    { "type": "image_picker", "id": "qr_image", "label": "App QR code", "info": "Shown beside the links; hover to enlarge (computers only)" },
    { "type": "text", "id": "qr_caption", "label": "QR caption", "default": "Scan to install (Android)" },
    { "type": "header", "content": "Row 1, icons" },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": true },
    { "type": "checkbox", "id": "show_country", "label": "Show country / currency badge", "default": true },

    { "type": "header", "content": "Mobile menu grouping" },
    { "type": "text", "id": "mobile_group1_label", "label": "Mobile menu, first group label", "info": "Heads the first group of navigation items below (see the item count setting).", "default": "Shop Collections" },
    { "type": "range", "id": "mobile_group1_count", "label": "Mobile menu, items in first group", "info": "How many navigation items sit under the first group label. The rest go under the second label.", "min": 1, "max": 20, "step": 1, "default": 9 },
    { "type": "text", "id": "mobile_group2_label", "label": "Mobile menu, second group label", "info": "Groups the remaining navigation items below.", "default": "More Categories" },

    { "type": "header", "content": "Wholesale" },
    { "type": "text", "id": "wholesale_whatsapp_number",  "label": "Wholesale WhatsApp number", "info": "Include country code, e.g. 919876543210. Leave blank to hide this link." },
    { "type": "text", "id": "wholesale_whatsapp_label",   "label": "Wholesale link label", "default": "Wholesale Enquiries" },
    { "type": "text", "id": "wholesale_whatsapp_message", "label": "Wholesale pre-filled message", "default": "Hi, I would like to know more about wholesale orders." },

    { "type": "header", "content": "Concert tickets" },
    { "type": "text", "id": "concert_whatsapp_number",    "label": "Concert tickets WhatsApp number", "info": "Include country code, e.g. 919876543210. Leave blank to hide this link." },
    { "type": "text", "id": "concert_whatsapp_label",     "label": "Concert tickets link label", "default": "Book Concert Tickets" },
    { "type": "text", "id": "concert_whatsapp_message",   "label": "Concert tickets pre-filled message", "default": "Hi, I would like to book concert tickets." }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Navigation item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "badge", "label": "Badge text", "info": "Optional. Renders as a small pill next to the label (e.g. Beauty & Wellness), or as trailing text when Highlight is on (e.g. New Arrivals)." },
        { "type": "color", "id": "badge_color", "label": "Badge pill colour", "default": "#0F5A43" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight (gold text treatment)", "default": false },
        { "type": "text", "id": "mega_panel", "label": "Mega menu panel key", "info": "Internal key that ties this item to its mega menu panel. Leave blank for a plain link with no dropdown (e.g. All Essentials)." },
        { "type": "link_list", "id": "mega_menu", "label": "Mega menu (optional)", "info": "Pick a navigation menu to replace this item's built-in mega menu columns. Each top-level menu link becomes a column heading; its sub-links become that column's links. Leave blank to keep the current mega menu exactly as is." },
        { "type": "text", "id": "col1_desc", "label": "Column 1 description", "info": "Used only when Mega menu (above) is set." },
        { "type": "text", "id": "col2_desc", "label": "Column 2 description" },
        { "type": "text", "id": "col3_desc", "label": "Column 3 description" },
        { "type": "text", "id": "col4_desc", "label": "Column 4 description" },
        { "type": "text", "id": "col5_desc", "label": "Column 5 description" },
        { "type": "text", "id": "col6_desc", "label": "Column 6 description" },
        { "type": "text", "id": "col7_desc", "label": "Column 7 description" },
        { "type": "text", "id": "col8_desc", "label": "Column 8 description" },
        { "type": "text", "id": "col9_desc", "label": "Column 9 description" }
      ]
    }
  ],
  "max_blocks": 50
}
{% endschema %}
