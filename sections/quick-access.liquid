{%- comment -%}
  Quick Access — one tile per menu tab.

  Deliberately has NO preset blocks: tiles are chosen in the Theme Editor, not invented here.
  Until tiles are added the section renders nothing at all.

  Each tile links to its tab page, where the Department sub-menu section shows that tab's
  menu. Tiles show their image only when one is picked; otherwise the first letter of the label.
  Tiles whose link is missing render nothing.
{%- endcomment -%}

{%- assign tile_blocks = section.blocks | where: 'type', 'tile' -%}
{%- if tile_blocks.size > 0 -%}

<section class="section quick-access" aria-labelledby="quick-access-heading">
  <div class="container">

    <div class="section__header-row">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section__heading font-serif" id="quick-access-heading">
          {{ section.settings.heading | default: 'Find What You Need' | escape }}
        </h2>
      </div>
    </div>

    <ul class="quick-access__grid">
      {%- for block in tile_blocks -%}
        {%- assign tile_collection = collections[block.settings.collection] -%}
        {%- assign tile_url = block.settings.custom_link | default: tile_collection.url -%}
        {%- assign tile_img = block.settings.image -%}

        {%- if tile_url != blank and block.settings.label != blank -%}
          <li class="quick-access__item" {{ block.shopify_attributes }}>
            <a href="{{ tile_url | escape }}" class="quick-access__tile">
              <span class="quick-access__media">
                {%- if tile_img != blank -%}
                  <img
                    src="{{ tile_img | image_url: width: 320 }}"
                    srcset="{{ tile_img | image_url: width: 160 }} 160w,
                            {{ tile_img | image_url: width: 320 }} 320w"
                    sizes="(min-width: 1024px) 160px, (min-width: 768px) 132px, 18vw"
                    alt="{{ tile_img.alt | default: block.settings.label | escape }}"
                    width="160" height="160"
                    {% if forloop.index <= 3 %}loading="eager"{% else %}loading="lazy"{% endif %}
                    decoding="async"
                    class="quick-access__img">
                {%- else -%}
                  <span class="quick-access__letter" aria-hidden="true">{{ block.settings.label | slice: 0 | upcase }}</span>
                {%- endif -%}
              </span>
              <span class="quick-access__label">{{ block.settings.label | escape }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  </div>
</section>

{%- endif -%}

{% schema %}
{
  "name": "Quick Access",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text",    "default": "SHOP BY CATEGORY" },
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Find What You Need" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "text",         "id": "label",       "label": "Label", "info": "Use the menu tab's name. Gloss Tamil terms in English parens, e.g. \"Sambrani (dhoop)\"." },
        { "type": "collection",   "id": "collection",  "label": "Collection", "info": "The tile links here. A tile with no collection and no custom link is skipped." },
        { "type": "url",          "id": "custom_link", "label": "Custom link (overrides the collection link)" },
        { "type": "image_picker", "id": "image",       "label": "Tile image", "info": "Optional. Square, subject centred, cropped to a circle. Without one the tile shows the first letter of the label." }
      ]
    }
  ],
  "presets": [
    { "name": "Quick Access", "blocks": [] }
  ]
}
{% endschema %}
